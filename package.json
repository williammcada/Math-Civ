{
  "name": "sekigahara-prototype",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node --import tsx scripts/validate-content.ts",
    "build": "npm run typecheck && npm run validate && vite build && node scripts/precache.mjs",
    "test:e2e": "vitest run tests/integration/ui.test.ts",
    "audit:release": "node scripts/audit-release.mjs",
    "tauri": "tauri",
    "windows:build": "tauri build --target x86_64-pc-windows-msvc",
    "build:local": "vite build --config vite.local.config.ts && node scripts/local-edition.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "test:offline": "node scripts/offline-test/run-unit.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
