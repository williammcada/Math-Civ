{
  "$schema": "../schemas/crises.schema.json",
  "schemaVersion": 1,
  "id": "sekigahara_crises_v1",
  "crises": [
    {
      "id": "famine",
      "titleStringId": "crisis.famine.title",
      "eventAssetId": "EVENT_CRISIS_FAMINE",
      "baseWeight": 5,
      "weightRules": [
        { "source": "ricePressurePoints", "multiply": 2 },
        { "whenFlag": "civilian_underfed", "add": 20 },
        { "whenFlag": "poor_harvest", "add": 10 },
        { "whenFlag": "famine_weight_relief_active", "add": -10 },
        { "whenFlag": "home_relief_weight_reduction_active", "add": -10 }
      ],
      "fullResponse": {
        "id": "famine_release_rice",
        "challengeTemplateId": "math_crisis_famine",
        "baseCost": { "food": 180 },
        "primaryCost": "food",
        "preventionPerThousand": 1000,
        "successEffects": { "publicOrder": 4 }
      },
      "partialResponse": {
        "id": "famine_ration",
        "baseCost": { "food": 80 },
        "preventionPerThousand": 500,
        "sideEffects": { "publicOrder": -6 }
      },
      "acceptResponse": { "id": "famine_accept" },
      "baseHarmAtSeverity2": { "food": -120, "publicOrder": -14, "prosperity": -8 }
    },
    {
      "id": "rebellion",
      "titleStringId": "crisis.rebellion.title",
      "eventAssetId": "EVENT_CRISIS_REBELLION",
      "baseWeight": 5,
      "weightRules": [
        { "source": "publicOrderPoints", "multiply": 2 },
        { "source": "authorityPoints", "multiply": 1 },
        { "whenFlag": "tax_rate_30", "add": 10 },
        { "whenFlag": "unpaid_wages", "add": 10 },
        { "whenFlag": "home_relief_weight_reduction_active", "add": -10 }
      ],
      "fullResponse": {
        "id": "rebellion_relief_negotiate",
        "challengeTemplateId": "math_crisis_rebellion",
        "baseCost": { "food": 100, "currency": 80, "authority": 10 },
        "primaryCost": "currency",
        "preventionPerThousand": 1000,
        "successEffects": { "publicOrder": 5 }
      },
      "partialResponse": {
        "id": "rebellion_suppress",
        "baseCost": { "currency": 70 },
        "preventionPerThousand": 500,
        "sideEffects": { "defense": -5, "authority": -8 }
      },
      "acceptResponse": { "id": "rebellion_accept" },
      "baseHarmAtSeverity2": { "publicOrder": -18, "authority": -12, "currency": -80 }
    },
    {
      "id": "flood",
      "titleStringId": "crisis.flood.title",
      "eventAssetId": "EVENT_CRISIS_FLOOD",
      "baseWeight": 5,
      "weightRules": [
        { "source": "infrastructurePoints", "multiply": 2 },
        { "whenFlag": "heavy_rain", "add": 25 },
        { "whenFlag": "route_damaged", "add": 10 }
      ],
      "fullResponse": {
        "id": "flood_reinforce_levees",
        "challengeTemplateId": "math_crisis_flood",
        "baseCost": { "materials": 120, "currency": 60 },
        "primaryCost": "materials",
        "preventionPerThousand": 1000,
        "successEffects": { "infrastructure": 3 }
      },
      "partialResponse": {
        "id": "flood_evacuate",
        "baseCost": { "currency": 70 },
        "preventionPerThousand": 500,
        "sideEffects": { "prosperity": -5 }
      },
      "acceptResponse": { "id": "flood_accept" },
      "baseHarmAtSeverity2": { "infrastructure": -16, "food": -120, "routeDamage": 1 }
    },
    {
      "id": "plague",
      "titleStringId": "crisis.plague.title",
      "eventAssetId": "EVENT_CRISIS_PLAGUE",
      "baseWeight": 5,
      "weightRules": [
        { "when": { "path": "edo.prosperity", "min": 60 }, "add": 15 },
        { "whenFlag": "travel_activity_high", "add": 15 },
        { "whenFlag": "civilian_underfed", "add": 20 },
        { "whenFlag": "unresolved_prior_crisis", "add": 10 }
      ],
      "fullResponse": {
        "id": "plague_clinics_isolation",
        "challengeTemplateId": "math_crisis_plague",
        "baseCost": { "currency": 110, "materials": 60 },
        "primaryCost": "currency",
        "preventionPerThousand": 1000,
        "successEffects": { "publicOrder": 2 }
      },
      "partialResponse": {
        "id": "plague_close_routes",
        "baseCost": { "currency": 70 },
        "preventionPerThousand": 500,
        "sideEffects": { "coalitionCohesion": -4 }
      },
      "acceptResponse": { "id": "plague_accept" },
      "baseHarmAtSeverity2": { "estimatedHouseholds": -120, "prosperity": -10, "readiness": -5 }
    },
    {
      "id": "raid",
      "titleStringId": "crisis.raid.title",
      "eventAssetId": "EVENT_CRISIS_RAID",
      "baseWeight": 5,
      "weightRules": [
        { "when": { "path": "threats.westernMomentum", "min": 70 }, "add": 20 },
        { "when": { "path": "edo.defense", "max": 49 }, "add": 20 },
        { "whenFlag": "field_army_away", "add": 10 },
        { "whenFlag": "unpaid_wages", "add": 10 }
      ],
      "fullResponse": {
        "id": "raid_fortify_depots",
        "challengeTemplateId": "math_crisis_raid",
        "baseCost": { "materials": 100, "currency": 50 },
        "primaryCost": "materials",
        "preventionPerThousand": 1000,
        "successEffects": { "defense": 3 }
      },
      "partialResponse": {
        "id": "raid_pay_withdraw",
        "baseCost": { "currency": 100, "authority": 5 },
        "preventionPerThousand": 500,
        "sideEffects": {}
      },
      "acceptResponse": { "id": "raid_accept" },
      "baseHarmAtSeverity2": { "food": -100, "materials": -60, "defense": -10 }
    }
  ]
}
