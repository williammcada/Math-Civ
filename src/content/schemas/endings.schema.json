{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-civilization.local/schemas/endings.schema.json",
  "title": "Math & Civilization Endings",
  "type": "object",
  "required": ["schemaVersion", "id", "tiers", "clauseSelection", "clauses"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "tier", "titleStringId", "openingStringId", "assetId"],
        "properties": {
          "id": { "type": "string" },
          "tier": { "enum": ["good", "normal", "bad"] },
          "titleStringId": { "type": "string" },
          "openingStringId": { "type": "string" },
          "assetId": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "clauseSelection": { "type": "object" },
    "clauses": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "group", "priority", "stringId"],
        "properties": {
          "id": { "type": "string" },
          "group": { "type": "string" },
          "priority": { "type": "integer" },
          "condition": { "type": "object" },
          "all": { "type": "array", "items": { "type": "object" } },
          "stringId": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
