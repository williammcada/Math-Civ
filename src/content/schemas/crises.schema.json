{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-civilization.local/schemas/crises.schema.json",
  "title": "Math & Civilization Crises",
  "type": "object",
  "required": ["schemaVersion", "id", "crises"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "crises": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "titleStringId", "eventAssetId", "baseWeight", "weightRules", "fullResponse", "partialResponse", "acceptResponse", "baseHarmAtSeverity2"],
        "properties": {
          "id": { "enum": ["famine", "rebellion", "flood", "plague", "raid"] },
          "titleStringId": { "type": "string" },
          "eventAssetId": { "type": "string" },
          "baseWeight": { "type": "integer", "minimum": 0 },
          "weightRules": { "type": "array" },
          "fullResponse": { "type": "object" },
          "partialResponse": { "type": "object" },
          "acceptResponse": { "type": "object" },
          "baseHarmAtSeverity2": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
