{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-civilization.local/schemas/balance.schema.json",
  "title": "Math & Civilization Balance Data",
  "type": "object",
  "required": ["schemaVersion", "id", "limits", "attempts", "economy", "crisis", "battle", "realmScore", "endings"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "limits": { "$ref": "#/$defs/object" },
    "attempts": { "$ref": "#/$defs/object" },
    "economy": { "$ref": "#/$defs/object" },
    "shortage": { "$ref": "#/$defs/object" },
    "relationshipBands": { "$ref": "#/$defs/object" },
    "crisis": { "$ref": "#/$defs/object" },
    "battle": { "$ref": "#/$defs/object" },
    "realmScore": { "$ref": "#/$defs/object" },
    "endings": { "$ref": "#/$defs/object" }
  },
  "$defs": {
    "object": { "type": "object", "minProperties": 1 }
  },
  "additionalProperties": false
}
